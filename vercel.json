{
  "outputDirectory": "dist-web",
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-tienhiep.lyvuha.com/api/:path*"
    },
    {
      "source": "/translate",
      "destination": "https://api-tienhiep.lyvuha.com/translate"
    },
    {
      "source": "/translate_stream",
      "destination": "https://api-tienhiep.lyvuha.com/translate_stream"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://api-tienhiep.lyvuha.com/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api-tienhiep.lyvuha.com/health"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
